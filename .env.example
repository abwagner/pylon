# Plane Personal Access Token. Generate at {plane_base_url}/profile/api-tokens
# Must belong to a member of the target workspace with write access on work items.
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub webhook secret. Must match the secret configured in the GitHub repo's webhook settings.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Plane webhook secret — must match the secret configured on the Plane webhook
# pointing at /webhook/plane. When unset, pylon accepts unsigned Plane webhooks with a
# startup warning. Same generation: openssl rand -hex 32
PLANE_WEBHOOK_SECRET=

# Path to the YAML config (defaults to ./config.yaml in container).
CONFIG_PATH=/app/config.yaml

# Logging verbosity. INFO is fine for production; DEBUG when investigating webhook deliveries.
LOG_LEVEL=INFO
